<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <!-- Name -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EMILY WRIGHT"
            android:textColor="#1A1A1A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- Blue Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5B7C99"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET JOB TITLE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Contact Info Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="Your Gmail"
                android:textColor="#444444"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Tell Number"
                android:textColor="#444444"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#5B7C99"
            android:layout_marginBottom="20dp" />

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dear Hiring Manager,"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Intro Paragraph -->
        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="It is with great interest that I submit my application..."
            android:textColor="#333333"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <!-- Why Me Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why Me?"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Why Me Body / Bullets -->
        <TextView
            android:id="@+id/tvWhyMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Bullet points"
            android:textColor="#333333"
            android:textSize="13.5sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Why Company Heading -->
        <TextView
            android:id="@+id/companyname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why (Company Name)?"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Why Company Body -->
        <TextView
            android:id="@+id/tvWhyCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Company details..."
            android:textColor="#333333"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <!-- Closing -->
        <TextView
            android:id="@+id/tvClosing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yours Sincerely,"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Signature Name -->
        <TextView
            android:id="@+id/tvSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>